<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           targetNamespace="http://emergentdotorg.github.io/gittle/configuration/1.0.0"
           xmlns="http://emergentdotorg.github.io/gittle/configuration/1.0.0">

  <xs:complexType name="Configuration">
    <xs:sequence>

      <xs:element name="mavenLike" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Add '-SNAPSHOT' to all versions that do not correspond to a release.
            Deprecated use 'strategy' instead.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="strategy" type="Strategy" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Define the strategy to use for version resolution.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="scriptType" type="ScriptType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Define the script type.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="script" type="ScriptContent" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Define the script content.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="policy" type="LookupPolicy" minOccurs="0">
        <xs:annotation>
          <xs:documentation>The policy used to find the base tag from which the version is computed.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="autoIncrementPatch" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Control how a base version is ued to calculate the new version.  Here the patch number of the version will
            be incremented. If version X.Y.Z is found as base version, then X.Y.(Z+1) will be used for the new version.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="useCommitDistance" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Add a distance number from the base version as a version qualifier.
            For example if HEAD is 3 commit ahead the base version 1.0.0 then calculated version will be 1.0.0-3
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="useDirty" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Add a 'dirty' qualifier if the git workspace contains non-ignored, uncommitted files.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="failIfDirty" type="xs:boolean" minOccurs="0" default="false">
        <xs:annotation>
          <xs:documentation>If true and the dirty state is detected then make the build fail</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="useGitCommitId" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Appends a qualifier with the git SHA1 of the HEAD commit.
            The length is controlled by the property 'gitCommitIdLength'.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="gitCommitIdLength" type="xs:integer" minOccurs="0"></xs:element>

      <xs:element name="maxSearchDepth" type="xs:integer" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Define the commit graph search depth at which to stop looking for tags.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="useGitCommitTimestamp" type="xs:boolean" minOccurs="0" default="false">
        <xs:annotation>
          <xs:documentation>Appends a qualifier with a git HEAD commit timestamp</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="nonQualifierBranches" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Comma separated list of branches for which no qualifier should be used.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="exclusions" type="Exclusions" minOccurs="0"></xs:element>

      <xs:element name="useDefaultBranchingPolicy" type="xs:boolean" minOccurs="0"></xs:element>

      <xs:element name="regexVersionTag" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Java regular expression to find tags to extract version from.
            If omitted default value is used: v?([0-9]+(?:\.[0-9]+){0,2}(?:-[a-zA-Z0-9\-_]+)?)
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="branchPolicies" type="BranchPolicies" minOccurs="0"></xs:element>

      <xs:element name="versionPattern" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Used only when strategy 'PATTERN' is used.
            Defines the pattern to compute the version for standard commits (i.e. commits not having any tag).
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="tagVersionPattern" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Used only when strategy 'PATTERN' is used.
            Defines the pattern to compute the version for tag commits (i.e. commits having one or more parsable tags).
          </xs:documentation>
        </xs:annotation>
      </xs:element>

    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Exclusions">
    <xs:sequence>
      <xs:element name="exclusion" type="xs:string" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            Relative path to a directory to be excluded by gittle.
            Paths are relative to the base multi-module directory of the maven project.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BranchPolicies">
    <xs:sequence>
      <xs:element name="branchPolicy" type="BranchPolicy" maxOccurs="unbounded"></xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BranchPolicy">
    <xs:sequence>
      <xs:annotation>
        <xs:documentation></xs:documentation>
      </xs:annotation>

      <xs:element name="pattern" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            Java regex pattern that will match branch name.
            The regex pattern to be valid MUST contain a unique group selection.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="transformations" type="Transformations" minOccurs="0"></xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Transformations">
    <xs:sequence>
      <xs:element name="transformation" type="xs:string" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            A transformation to apply, value taken from org.emergent.gittle.BranchingPolicy#BranchNameTransformations
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="Strategy" final="restriction">
    <xs:annotation>
      <xs:documentation>List of available strategies.</xs:documentation>
    </xs:annotation>
    <xs:restriction>
      <xs:enumeration value="MAVEN"/>
      <xs:enumeration value="CONFIGURABLE"/>
      <xs:enumeration value="PATTERN"/>
      <xs:enumeration value="SCRIPT"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ScriptType" final="restriction">
    <xs:annotation>
      <xs:documentation>Used only when strategy 'SCRIPT' is used. List of available script types.</xs:documentation>
    </xs:annotation>
    <xs:restriction>
      <xs:enumeration value="GROOVY"/>
      <xs:enumeration value="BEAN_SHELL"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ScriptContent" final="restriction">
    <xs:annotation>
      <xs:documentation>Used only when strategy 'SCRIPT' is used. Script content.</xs:documentation>
    </xs:annotation>
    <xs:restriction>
      <xs:enumeration value="GROOVY"/>
      <xs:enumeration value="BEAN_SHELL"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LookupPolicy" final="restriction">
    <xs:annotation>
      <xs:documentation>List of available LookupPolicies.</xs:documentation>
    </xs:annotation>
    <xs:restriction>
      <xs:enumeration value="MAX">
        <xs:annotation>
          <xs:documentation>The reachable tag with highest version is the basis of computation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LATEST">
        <xs:annotation>
          <xs:documentation>The latest, by date, tag with will be used for basis of computation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NEAREST">
        <xs:annotation>
          <xs:documentation>
            The nearest tag to HEAD will be used for the basis of computation, with LATEST as tie-breaker.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="configuration" type="Configuration"></xs:element>

</xs:schema>
