<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
  xmlns="http://emergentdotorg.github.io/gitver/configuration/1.0.0"
  targetNamespace="http://emergentdotorg.github.io/gitver/configuration/1.0.0">

  <xs:element name="configuration">
    <xs:complexType>
      <xs:complexContent mixed="false">
        <xs:extension base="Options">
          <xs:all>
            <xs:element name="disabled" type="xs:boolean" minOccurs="0"/>
            <xs:element name="considerTagsOnBranches" type="xs:boolean" minOccurs="0"/>
            <xs:element name="projectVersionPattern" type="xs:string" minOccurs="0"/>
            <xs:element name="refs" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="ref" type="Ref" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
                <xs:attribute name="appendDefaults" type="xs:boolean" default="false"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="relatedProjects" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="project" type="Project" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:all>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="Ref">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Git status description with information on how to process a git state, as well as
        information on how to determine if this description is a match against the current state.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="Options">
        <xs:all>
          <xs:element name="type" type="RefType"/>
          <xs:element name="version" type="xs:string"/>
          <xs:element name="pattern" type="xs:string" minOccurs="0">
            <xs:annotation>
              <xs:documentation xml:lang="en">The ref name matching regex.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="properties" type="Properties" minOccurs="0"/>
          <xs:element name="userProperties" type="Properties" minOccurs="0"/>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="Options">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Options that can be configured at any level.
      </xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="tagPattern" type="xs:string" minOccurs="0"/>
      <xs:element name="followFirstParentOnly" type="xs:boolean" minOccurs="0"/>
      <xs:element name="updateAttachedPom" type="xs:boolean" minOccurs="0"/>
      <xs:element name="updateSourcePom" type="xs:boolean" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:simpleType name="RefType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="branch"/>
      <xs:enumeration value="commit"/>
      <xs:enumeration value="tag"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Properties">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Project">
    <xs:all>
      <xs:element name="groupId" type="xs:string"/>
      <xs:element name="artifactId" type="xs:string"/>
    </xs:all>
  </xs:complexType>

</xs:schema>
